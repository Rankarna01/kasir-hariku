# ==========================================
# LOVE CAKES POS - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==========================================

# Application Settings
APP_ENV=local
APP_NAME="Love Cakes POS"
# Kosongkan agar URL mengikuti domain dan folder tempat aplikasi dijalankan.
# Isi hanya jika deployment membutuhkan URL tetap, misalnya https://pos.example.com/
BASE_URL=

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sim-kue
DB_USER=root
DB_PASS=

# ==========================================
# ONLINE CHANNEL INTEGRATION (API KEYS)
# ==========================================

# GrabFood Merchant Partner API
GRAB_ENV=sandbox
GRAB_MERCHANT_ID=
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_API_BASE_URL=https://partner-api.stg-grab.com
GRAB_WEBHOOK_SECRET=

# GoFood Partner API Configuration
GOFOOD_ENV=sandbox
GOFOOD_MERCHANT_ID=
GOFOOD_API_KEY=

# ShopeeFood Merchant API
SHOPEEFOOD_MERCHANT_ID=
SHOPEEFOOD_PARTNER_KEY=
