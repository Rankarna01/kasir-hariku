# ==========================================
# LOVE CAKES POS - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Settings
APP_ENV=production
APP_NAME="Love Cakes POS"
# Kosongkan agar URL mengikuti domain dan folder tempat aplikasi dijalankan.
# Isi hanya jika deployment membutuhkan URL tetap, misalnya https://pos.example.com/
BASE_URL=

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_pos_ku
DB_USER=root
DB_PASS=

# ==========================================
# ONLINE CHANNEL INTEGRATION (API KEYS)
# ==========================================

# GrabFood Merchant Partner API
# ------------------------------------
# [SANDBOX - commented out]
# GRAB_ENV=sandbox
# GRAB_MERCHANT_ID=GF-MERCHANT-88219
# GRAB_CLIENT_ID=grab_client_sample_id_12345
# GRAB_CLIENT_SECRET=grab_client_sample_secret_998877
# GRAB_API_BASE_URL=https://partner-api.stg-grab.com
# GRAB_WEBHOOK_SECRET=grab_wh_sec_77123
# ------------------------------------
# [PRODUCTION - isi dengan credentials asli dari Grab Developer Portal]
GRAB_ENV=production
GRAB_MERCHANT_ID=
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_API_BASE_URL=https://partner-api.grab.com
GRAB_WEBHOOK_SECRET=

# GoFood Partner API Configuration
# ------------------------------------
# [SANDBOX - commented out]
# GOFOOD_ENV=sandbox
# GOFOOD_MERCHANT_ID=GFD-98123
# GOFOOD_API_KEY=gofood_sample_key_123
# ------------------------------------
# [PRODUCTION]
GOFOOD_ENV=production
GOFOOD_MERCHANT_ID=
GOFOOD_API_KEY=

# ShopeeFood Merchant API
# ------------------------------------
# [SANDBOX - commented out]
# SHOPEEFOOD_MERCHANT_ID=SPF-44120
# SHOPEEFOOD_PARTNER_KEY=shopee_sample_key_554
# ------------------------------------
# [PRODUCTION]
SHOPEEFOOD_MERCHANT_ID=
SHOPEEFOOD_PARTNER_KEY=
